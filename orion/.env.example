# Copie este arquivo para ".env" e preencha.
# Crie sua chave em https://console.anthropic.com/  (Settings > API Keys)
ANTHROPIC_API_KEY=sk-ant-coloque-sua-chave-aqui

# Banco de dados Neon (memória permanente do Orion).
# Crie grátis em https://neon.tech > New Project > copie a "Connection string".
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Seu nome (o Orion vai te chamar assim)
ORION_NOME_USUARIO=

# Modelo e nível de esforço (low = mais rápido, high = mais caprichado)
ORION_MODELO=claude-opus-5-5
ORION_ESFORCO=low

# 1 = permite que o Orion rode comandos de terminal/PowerShell (automação avançada).
# Deixe 0 se não quiser que ele execute comandos.
ORION_PERMITIR_COMANDOS=0

ORION_PORTA=8765
ORION_ABRIR_NAVEGADOR=1
